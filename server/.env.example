# Copie para server/.env e ajuste. Não versione o .env com senhas reais.

# desenvolvimento mostra a mensagem dos erros internos; producao esconde.
APP_AMBIENTE=desenvolvimento

# Banco MySQL (alvo de produção)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=torre_do_eclipse
DB_USUARIO=torre_app
DB_SENHA=defina-uma-senha-aqui

# Alternativa sem MySQL instalado (desenvolvimento e testes):
# DB_DRIVER=sqlite
# DB_ARQUIVO=server/dados/torre.sqlite

# Cookie de sessão só por HTTPS. Use true em produção.
SESSAO_SEGURA=false

# Origens extras aceitas além do próprio host (separadas por vírgula).
ORIGENS_PERMITIDAS=http://localhost:5173
